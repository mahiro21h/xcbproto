<xcb header="myextension" extension-xname="MIT-MY-EXTENSION" extension-name="Myextension" major-version="1" minor-version="1">

  <!-- Types -->

  <import>xproto</import>

  <!-- Errors -->
  <!-- Requests -->
  <request name="QueryVersion" opcode="0">
    <field type="CARD8" name="client_major_version"/>
    <field type="CARD8" name="client_minor_version"/>
    <pad bytes="2"/>
    <reply>
      <pad bytes="1"/>
      <field type="CARD16" name="server_major_version"/>
      <field type="CARD16" name="server_minor_version"/>
      <pad bytes="20"/>
    </reply>
  </request>

  <request name="LockScreen" opcode="2">
  </request>

  <request name="UnlockScreen" opcode="3">
  </request>

  <request name="RegisterScreenLocker" opcode="4">
    <field type="INT32"  name="pid"/>
    <field type="CARD32" name="exec_path_len"/> <!-- unused -->
    <pad bytes="20"/>
    <list type="char"    name="exec_path"> <!-- unused -->
        <fieldref>exec_path_len</fieldref>
    </list>
    <reply>
      <field type="CARD8"  name="response"/>
      <field type="CARD32" name="exec_path_len"/>
      <pad bytes="20"/>
      <list type="char"    name="exec_path">
          <fieldref>exec_path_len</fieldref>
      </list>
    </reply>
  </request>

  <request name="UnregisterScreenLocker" opcode="5">
  </request>

  <request name="CreateWindow" opcode="6">
    <field type="Window" name="parent"/>
    <field type="VISUALID" name="visual"/>
    <field type="CARD32" name="background_pixel_len"/>
    <pad bytes="20"/>
    <list type="CARD32" name="background_pixel">
      <fieldref>background_pixel_len</fieldref>
    </list>
    <reply>
      <field type="CARD8"  name="response"/>
      <field type="Window" name="locker_window"/>
    </reply>
  </request>

  <request name="DestroyWindow" opcode="7">
    <field type="Window" name="locker_window"/>
  </request>

  <!-- Events -->

</xcb>
